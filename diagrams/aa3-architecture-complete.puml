@startuml AttackAware3_Architecture
title AttackAware 3.0 — Complete System Architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultFontSize 11

actor "Super Admin" as SA
actor "Company Admin" as CA
actor "Employee" as EMP
actor "Individual User" as IND
actor "Phishing Target" as PUB

package "Frontend — Next.js 15" as FE {

  package "Auth Pages" {
    [login/page.tsx]
    [register/page.tsx]
  }

  package "Dashboard Pages" {
    [dashboard/page.tsx]
    [admin/page.tsx]
    [employee/page.tsx]
    [super-admin/page.tsx]
    [campaigns/page.tsx]
    [companies/page.tsx]
    [employees/page.tsx]
    [analytics/page.tsx]
    [leaderboard/page.tsx]
    [reports/page.tsx]
    [settings/page.tsx]
    [forum/page.tsx]
    [individual/page.tsx]
    [profile/page.tsx]
    [progress/page.tsx]
    [tasks/page.tsx]
    [messages/page.tsx]
    [attacks/page.tsx]
  }

  package "Phishing Lure Pages" {
    [verify-bank]
    [verify-hr]
    [verify-it]
    [verify-delivery]
    [verify-password]
    [verify-caught]
    [verify-reported]
  }

  package "Frontend Services" {
    [api.ts]
    [authApi.ts]
    [campaignApi.ts]
    [analyticsApi.ts]
    [employeeApi.ts]
    [companyApi.ts]
    [simulationApi.ts]
    [leaderboardApi.ts]
    [superAdminApi.ts]
    [campaignReportsApi.ts]
    [contactApi.ts]
    [forumApi.ts]
    [attacksApi.ts]
  }

  package "UI Components" {
    [enhanced-sidebar.tsx]
    [enhanced-header.tsx]
    [metric-card.tsx]
    [theme-provider.tsx]
    [ProtectedRoute.ts]
    [shadcn-ui-components]
  }
}

package "Backend — Express + TypeScript" as BE {

  package "Middleware" {
    [security]
    [rateLimiter]
    [auth-JWT-verify]
    [rbac]
    [validation]
    [featureGating]
  }

  package "Routes" {
    [/api/auth]
    [/api/campaigns]
    [/api/analytics]
    [/api/company]
    [/api/employees]
    [/api/leaderboard]
    [/api/track]
    [/api/webhooks]
    [/api/simulations]
    [/api/super-admin]
    [/api/reports]
    [/api/settings]
    [/api/videos]
    [/api/quizzes]
    [/api/games]
    [/api/forum]
    [/api/messages]
    [/api/tasks]
    [/api/attacks]
    [/api/plans]
    [/api/progress]
  }

  package "Controllers" {
    [authController]
    [campaignController]
    [analyticsController]
    [companyController]
    [employeeController]
    [smishingController]
    [vishingController]
    [trackingController]
    [webhookController]
    [leaderboardController]
    [pdfReportController]
    [videoController]
    [quizController]
    [gameController]
    [forumController]
    [messageController]
    [taskController]
    [attackController]
    [planController]
    [progressController]
  }

  package "Services" {
    [analyticsService]
    [trackingService]
    [twilioService]
    [pdfReportService]
    [planService]
  }

  package "Queue" {
    [trackingQueue-Bull]
    [workers]
  }

  package "Lib" {
    [stateMachine]
    [botDetection]
    [idempotency]
    [jwt]
    [logger]
  }
}

database "MongoDB" as DB {
  [User]
  [Company]
  [Campaign]
  [SimulationResult]
  [SimulationEvent]
  [Leaderboard]
  [Video]
  [UserVideo]
  [Quiz]
  [QuizQuestion]
  [UserQuiz]
  [Game]
  [UserGame]
  [ForumPost]
  [ForumComment]
  [Attack]
  [Task]
  [Message]
  [MembershipPlan]
  [ContactMessage]
  [Setting]
}

cloud "External Services" {
  [TwilioAPI]
  [SMTPService]
  [RedisQueue]
}

SA --> [login/page.tsx]
CA --> [login/page.tsx]
EMP --> [login/page.tsx]
IND --> [login/page.tsx]
PUB --> [verify-bank]
PUB --> [verify-hr]
PUB --> [verify-it]

